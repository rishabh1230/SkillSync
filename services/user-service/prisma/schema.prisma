generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique
  email     String
  username  String
  phone_no     String?
  githubUrl    String?
  leetcodeUrl  String?
  portfolioUrl String?
  skills       String[]
  education    Json?
  createdAt    DateTime @default(now())
}